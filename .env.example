# Copy this file to .env and fill in the real values locally.
# Do not commit a real .env file with secrets.

# LLM Keys
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
LLM_PROVIDER=openai
ALLOW_LLM_FALLBACK=true
ALLOW_AGENT_FALLBACK=true
OPENAI_MODEL=gpt-4o-mini

# MongoDB (optional — API works without it)
MONGODB_URI=mongodb://localhost:27017

# PostgreSQL (optional — only for retriever + insight cards tools)
DATABASE_URL=postgresql://user:password@host:5432/postgres
POSTGRES_DSN=postgresql://user:password@host:5432/postgres

# PDF export (optional — only when export_report tool is called)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-2
REPORT_BUCKET=your-report-bucket

# Demo client
CLIENT_ID=demo_client
